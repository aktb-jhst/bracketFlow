rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(ownerUid) {
      return isSignedIn() && request.auth.uid == ownerUid;
    }

    // 1. 管理者専用：親大会フルバックアップ（マイ大会一覧・全種目・フルネーム・全設定）
    match /tournaments/{tid} {
      allow read: if isSignedIn() && resource.data.ownerUid == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if isSignedIn() && resource.data.ownerUid == request.auth.uid;
    }

    // 2. 公開ポータル用メタ情報（生徒・保護者閲覧用：1大会=1ドキュメント）
    match /live_tournaments/{tid} {
      allow read: if resource.data.publishEnabled == true || isOwner(resource.data.ownerUid);
      allow create: if isSignedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if isOwner(resource.data.ownerUid);
    }

    // 3. 公開ライブ種目ドキュメント（1種目=1ドキュメント・Spark無料枠最適化）
    //    - 生徒・保護者：publishEnabled==true のとき閲覧のみ可（名字設定時は事前マスク済データを格納）
    //    - 大会管理者：フル権限
    //    - 会場スタッフ：staff_sessions でPIN認証済みの端末のみ results/consolation/oop/updatedAt の更新可
    match /live_events/{docId} {
      allow read: if resource.data.publishEnabled == true || isOwner(resource.data.ownerUid);
      allow create: if isSignedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow delete: if isOwner(resource.data.ownerUid);
      allow update: if isOwner(resource.data.ownerUid)
        || (
          isSignedIn()
          && exists(/databases/$(database)/documents/live_events/$(docId)/staff_sessions/$(request.auth.uid))
          && get(/databases/$(database)/documents/live_events/$(docId)/staff_sessions/$(request.auth.uid)).data.pinVersion == resource.data.pinVersion
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['results', 'consolation', 'oop', 'updatedAt'])
        );

      // 会場スタッフPIN検証済みセッション（本人のみ読取可・リスト不可）
      match /staff_sessions/{uid} {
        allow get: if isSignedIn() && request.auth.uid == uid;
        allow list: if false;
        allow create, update: if isSignedIn()
          && request.auth.uid == uid
          && request.resource.data.pin is string
          && exists(/databases/$(database)/documents/staff_keys/$(docId + '__' + request.resource.data.pin))
          && request.resource.data.pinVersion == get(/databases/$(database)/documents/live_events/$(docId)).data.pinVersion;
        allow delete: if isSignedIn() && request.auth.uid == uid;
      }
    }

    // 4. スタッフPIN検証キー（クライアントからの読取・一覧は完全禁止、管理者のみ作成・削除）
    match /staff_keys/{keyId} {
      allow read: if false;
      allow create: if isSignedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if isSignedIn() && resource.data.ownerUid == request.auth.uid;
    }
  }
}
